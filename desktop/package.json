{
  "name": "hiep-si-net-chi",
  "productName": "Hiệp Sĩ Nét Chì",
  "version": "1.0.0",
  "description": "Hiệp Sĩ Nét Chì - game nhập vai online",
  "author": "Hiệp Sĩ Nét Chì",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "vn.hiepsinetchi.game",
    "productName": "Hiep Si Net Chi",
    "files": ["main.js", "game/**"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "portable": { "artifactName": "HiepSiNetChi-${version}-portable.exe" },
    "nsis": { "artifactName": "HiepSiNetChi-${version}-setup.exe", "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Hiệp Sĩ Nét Chì" }
  }
}
